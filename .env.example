# ═══════════════════════════════════════════════════════════════════════════
# Bayırlıoğlu — Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# Vercel'de aynı değişkenleri proje ayarlarından tanımlayın.
# ═══════════════════════════════════════════════════════════════════════════

# ─── SİTE ────────────────────────────────────────────────────────────────────
# ÖNEMLİ: Buraya sitenin O AN yayında olduğu adresi yazın — ileride
# kullanacağınız adresi değil.
#
# Ödeme geri dönüş (callback) adresi, e-posta bağlantıları, sitemap ve mesafeli
# satış sözleşmesi metni bu değerden üretilir. Yanlış adres yazılırsa müşteri
# kart bilgilerini girip ödemeyi tamamladıktan sonra var olmayan bir adrese
# yönlendirilir; para çekilmiş ama sipariş ekranı açılmamış olur.
#
# Şimdilik (Vercel):   https://<proje-adi>.vercel.app
# Alan adı bağlanınca: https://www.bayirlioglu.com
NEXT_PUBLIC_SITE_URL=

# Aktif marka: alb-tarim | alb-su-aritma
NEXT_PUBLIC_BRAND=alb-tarim

# ─── VERİTABANI (Supabase PostgreSQL) ────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ─── SUPABASE ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Yalnızca sunucuda kullanılır — asla istemciye sızdırmayın
SUPABASE_SERVICE_ROLE_KEY=

# ─── ADMİN PANELİ ────────────────────────────────────────────────────────────
# Admin giriş şifresi
ADMIN_PASSWORD=

# Admin oturum cookie'sini imzalamak için rastgele uzun bir dize.
# Üretmek için: openssl rand -base64 48
# Tanımlanmazsa ADMIN_PASSWORD kullanılır (önerilmez — şifre değişince tüm
# oturumlar düşer).
ADMIN_SESSION_SECRET=

# ─── İYZİCO ÖDEME ────────────────────────────────────────────────────────────
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Üretimde BOŞ bırakın → otomatik olarak canlı adres (api.iyzipay.com) kullanılır.
# Test için: https://sandbox-api.iyzipay.com
IYZICO_BASE_URL=

# Korumalı Alışveriş (escrow) kullanıyorsanız true yapın.
#
# Standart tek satıcılı hesapta teslimat bildirimi diye bir adım YOKTUR; para
# ödeme takviminize göre otomatik aktarılır ve bu değişkene dokunmanız
# gerekmez. Korumalı Alışveriş'te ise para siz kalemi onaylayana kadar
# iyzico'da bekletilir; bu değişken true olduğunda sipariş "Teslim Edildi"
# yapıldığında onay isteği otomatik gönderilir.
#
# Hangisinde olduğunuzu bilmiyorsanız iyzico'ya sorun; yanlış açmak isteğin
# hata dönmesine yol açar (teslimat kaydını bozmaz, yalnızca not düşülür).
IYZICO_KORUMALI_ALISVERIS=

# ─── WHATSAPP ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_ALB_TARIM=905071781633
NEXT_PUBLIC_WHATSAPP_ALBSU=905444142254
NEXT_PUBLIC_WHATSAPP_GROUP=905444142254

# ─── E-POSTA (Resend) ────────────────────────────────────────────────────────
# resend.com'da ücretsiz hesap açıp alan adınızı doğrulayın.
# Bu değerler tanımlı değilse e-posta gönderilmez; sipariş akışı etkilenmez,
# yalnızca sunucu loguna uyarı düşer.
RESEND_API_KEY=
EMAIL_FROM="Bayırlıoğlu <siparis@bayirlioglu.com>"

# Yeni sipariş bildirimi gönderilecek yönetici adresi (opsiyonel)
ADMIN_NOTIFY_EMAIL=
