// Happy Junior E-Ticaret — Prisma Schema
// Veritabanı: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"

  // engineType = "client"  ←  BU SATIR OLMADAN queryCompiler ETKİSİZ.
  //
  // previewFeatures listesine "queryCompiler" yazmak özelliği yalnızca
  // KULLANILABİLİR yapıyor; hangi motorun üretileceğini belirlemiyor. Motor
  // tipi ayrıca seçilmezse Prisma varsayılana, yani "library"ye düşüyor ve
  // istemciyi yerel Rust sorgu motoruna (libquery_engine.so.node) bağlı
  // üretiyor. O ikili dosya Workers'ta çalışamaz; workerd'de dosya sistemi
  // olmadığı için istemci açılışta
  //   "Prisma Client could not locate the Query Engine for runtime ..."
  // diyerek patlar. Tam olarak bu yaşandı.
  //
  // "client" seçildiğinde Prisma, Rust ikilisi yerine WASM sorgu derleyicisini
  // kullanan istemciyi üretiyor: Workers'ta çalışıyor ve paket ~14 MB'tan
  // ~1,6 MB'a iniyor.
  engineType = "client"

  // driverAdapters : bağlantı @prisma/adapter-pg üzerinden Hyperdrive'a gidiyor
  // queryCompiler  : sorgu planlaması Rust yerine WASM tarafında yapılıyor
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── MARKALAR ────────────────────────────────────────────────────────────────

model Brand {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?
  logoUrl     String?  @map("logo_url") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  categories Category[]
  products   Product[]
  orders     Order[]
  blogPosts  BlogPost[]

  @@map("brands")
}

// ─── KATEGORİLER ─────────────────────────────────────────────────────────────

model Category {
  id          Int      @id @default(autoincrement())
  brandId     Int      @map("brand_id")
  parentId    Int?     @map("parent_id")
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  icon        String?  @db.VarChar(100)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  brand    Brand      @relation(fields: [brandId], references: [id])
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]

  @@map("categories")
}

// ─── ÜRÜNLER ─────────────────────────────────────────────────────────────────

model Product {
  id               String  @id @default(cuid())
  categoryId       Int     @map("category_id")
  brandId          Int     @map("brand_id")
  name             String  @db.VarChar(255)
  slug             String  @unique @db.VarChar(255)
  description      String? @db.Text
  shortDescription String? @map("short_description") @db.VarChar(1000)
  sku              String? @unique @db.VarChar(100)
  barcode          String? @db.VarChar(100)

  // Fiyat
  price     Decimal  @db.Decimal(10, 2)
  salePrice Decimal? @map("sale_price") @db.Decimal(10, 2)

  /// ETKİN FİYAT — VERİTABANI ÜRETİR, UYGULAMA YAZMAZ.
  ///
  /// `COALESCE(sale_price, price)` değerini tutan bir "generated column".
  /// Varlık sebebi: ürünlerin %41'inde indirimli fiyat dolu, ama fiyat
  /// sıralaması ve fiyat aralığı filtresi `price` üzerinden çalışıyordu.
  /// Müşteri "ucuzdan pahalıya" sıraladığında liste fiyatına göre sıralanmış
  /// ama indirimli fiyatlar yazan bir liste görüyordu; "0–500 TL" filtresi de
  /// liste fiyatı 600, satış fiyatı 450 olan ürünü eliyordu.
  ///
  /// DİKKAT: Bu sütun `sql/arama-ve-fiyat-indeksleri.sql` ile yaratılıyor.
  /// `prisma db push` bunu NORMAL bir sütuna çevirmeye kalkar ve üretilen
  /// değeri kaybeder. Şema değişikliklerini migration ile yapın; `db push`
  /// kullanacaksanız önce bu sütunu ve indekslerini gözden geçirin.
  effectivePrice Decimal? @map("effective_price") @db.Decimal(10, 2)

  // Stok
  stockQuantity Int      @default(0) @map("stock_quantity")
  minStockLevel Int      @default(5) @map("min_stock_level")
  unit          String   @default("adet") @db.VarChar(50)
  weight        Decimal? @db.Decimal(8, 3)

  // Durum
  isActive   Boolean @default(true) @map("is_active")
  isFeatured Boolean @default(false) @map("is_featured")

  // SEO
  metaTitle       String? @map("meta_title") @db.VarChar(255)
  metaDescription String? @map("meta_description") @db.Text

  // Ürün markası (TİMAC AGRO, HAIFA, ALB TARIM, FERTIVAL vb.)
  productBrand String? @map("product_brand") @db.VarChar(100)

  // KDV oranı (%). Gübrede %1 veya %10, cihazda %20 olabilir.
  // Fiyatlar KDV DAHİL girilir; bu oran fatura matrahını ayrıştırmak için.
  vatRate Int @default(20) @map("vat_rate")

  // Değerlendirme (ortalama — review tablosu hazır değil iken burada tutuyoruz)
  rating      Decimal @default(0) @map("rating") @db.Decimal(3, 1)
  reviewCount Int     @default(0) @map("review_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // İlişkiler
  category   Category         @relation(fields: [categoryId], references: [id])
  brand      Brand            @relation(fields: [brandId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  specs      ProductSpec[]
  tags       ProductTag[]
  orderItems OrderItem[]
  favorites  Favorite[]

  @@index([brandId])
  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@index([isFeatured])
  @@map("products")
}

// ─── ÜRÜN GÖRSELLERİ ─────────────────────────────────────────────────────────

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId String  @map("product_id")
  url       String  @db.VarChar(500)
  altText   String? @map("alt_text") @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─── TEKNİK ÖZELLİKLER ───────────────────────────────────────────────────────

// ─── Beden / yaş varyasyonu ──────────────────────────────────────────────────
//
// Çocuk giyiminde her bedenin stoğu ayrı tutulur. Varyasyonu olan üründe
// `Product.stockQuantity` kullanılmaz; stok buradan okunur ve sepet/sipariş
// varyasyon üzerinden düşer. Varyasyonu olmayan ürünler (oyuncak, matara)
// eskisi gibi `Product.stockQuantity` ile çalışır.
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  // Müşterinin gördüğü etiket: "6-9 Ay", "2 Yaş", "86 cm", "Mavi / 3 Yaş"
  label         String   @db.VarChar(60)
  sku           String?  @unique @db.VarChar(100)
  stockQuantity Int      @default(0) @map("stock_quantity")
  // Boşsa ürünün fiyatı geçerli; bazı bedenler farklı fiyatlıysa doldurulur.
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, label])
  @@index([productId])
  @@map("product_variants")
}

model ProductSpec {
  id        Int     @id @default(autoincrement())
  productId String  @map("product_id")
  specName  String  @map("spec_name") @db.VarChar(100)
  specValue String  @map("spec_value") @db.VarChar(255)
  specUnit  String? @map("spec_unit") @db.VarChar(50)
  sortOrder Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specifications")
}

// ─── ETİKETLER ───────────────────────────────────────────────────────────────

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique @db.VarChar(100)
  slug     String       @unique @db.VarChar(100)
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String  @map("product_id")
  tagId     Int     @map("tag_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

// ─── KULLANICILAR ─────────────────────────────────────────────────────────────
// id: Supabase auth.users UUID ile eşleşir

model User {
  id        String   @id @db.Uuid
  email     String   @unique @db.VarChar(255)
  name      String?  @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  addresses      Address[]
  orders         Order[]
  favorites      Favorite[]
  returnRequests ReturnRequest[]

  @@map("users")
}

// ─── ADRESLER ─────────────────────────────────────────────────────────────────

model Address {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") @db.Uuid
  label      String   @db.VarChar(50) // "Ev", "Çiftlik", vb.
  fullName   String   @map("full_name") @db.VarChar(150)
  phone      String   @db.VarChar(20)
  line1      String   @db.VarChar(255)
  line2      String?  @db.VarChar(255)
  district   String   @db.VarChar(100)
  city       String   @db.VarChar(100)
  postalCode String?  @map("postal_code") @db.VarChar(10)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ─── SİPARİŞLER ───────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id String @id @default(cuid())

  // Müşteriye gösterilen sipariş numarası — yalnızca rakam.
  //
  // `id` bir cuid ("cmsi91lrv0001jl044fw4o5do"); telefonda okunmuyor, elle
  // yazılamıyor ve kargo/muhasebe evrağına yazılacak bir şeye benzemiyor.
  // Bu alan YYAAGG + 4 rastgele hane biçiminde 10 haneli bir numara tutuyor
  // (örn. 2608074831). Rastgele kısım sayesinde sipariş adedi dışarıdan
  // sayılamıyor; tarih öneki sayesinde yönetici numaraya bakınca günü görüyor.
  //
  // `id` iç kimlik olarak kalıyor (adresler, ilişkiler, revalidate yolları).
  // Eski siparişlerde bu alan boş olabileceği için opsiyonel.
  orderNumber String? @unique @map("order_number") @db.VarChar(20)

  userId    String      @map("user_id") @db.Uuid
  addressId String?     @map("address_id")
  brandId   Int         @map("brand_id")
  status    OrderStatus @default(PENDING)

  // Tutar dökümü — sonradan geri hesaplanamasın diye ayrı ayrı saklanır
  subtotal    Decimal? @db.Decimal(12, 2)
  shippingFee Decimal? @map("shipping_fee") @db.Decimal(10, 2)
  taxAmount   Decimal? @map("tax_amount") @db.Decimal(10, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)

  // Teslimat adresi anlık kopyası — müşteri adresini silse de sipariş bozulmaz
  shipFullName   String? @map("ship_full_name") @db.VarChar(150)
  shipPhone      String? @map("ship_phone") @db.VarChar(20)
  shipLine1      String? @map("ship_line1") @db.VarChar(255)
  shipLine2      String? @map("ship_line2") @db.VarChar(255)
  shipDistrict   String? @map("ship_district") @db.VarChar(100)
  shipCity       String? @map("ship_city") @db.VarChar(100)
  shipPostalCode String? @map("ship_postal_code") @db.VarChar(10)

  // Kargo takibi
  carrier        String?   @db.VarChar(100)
  trackingNumber String?   @map("tracking_number") @db.VarChar(100)
  shippedAt      DateTime? @map("shipped_at")
  deliveredAt    DateTime? @map("delivered_at")

  // Stok bir kez düşülsün diye (tekrarlanan callback koruması)
  stockReduced Boolean @default(false) @map("stock_reduced")

  // Mesafeli satış sözleşmesi / ön bilgilendirme onayı — yasal ispat
  contractAcceptedAt DateTime? @map("contract_accepted_at")
  contractIp         String?   @map("contract_ip") @db.VarChar(64)
  contractVersion    String?   @map("contract_version") @db.VarChar(20)

  // Fatura bilgileri — e-arşiv fatura için zorunlu
  invoiceType      String? @map("invoice_type") @db.VarChar(20) // "bireysel" | "kurumsal"
  invoiceTitle     String? @map("invoice_title") @db.VarChar(200) // kurumsal: ticaret unvanı
  invoiceTaxId     String? @map("invoice_tax_id") @db.VarChar(20) // TCKN (11) veya VKN (10)
  invoiceTaxOffice String? @map("invoice_tax_office") @db.VarChar(100)
  invoiceEmail     String? @map("invoice_email") @db.VarChar(255)

  // Kesilen e-faturanın PDF'i.
  //
  // Dosyanın kendisi Supabase Storage'da, `faturalar` adlı ÖZEL kovada duruyor.
  // Burada tutulan `invoiceFilePath` kova içindeki yol; herkese açık bir URL
  // DEĞİL. Fatura kişisel veri (ad, adres, TCKN/VKN) içerdiği için indirme
  // her seferinde kimlik doğrulanıp kısa ömürlü imzalı bağlantıyla yapılıyor.
  invoiceFilePath   String?   @map("invoice_file_path") @db.VarChar(400)
  invoiceFileName   String?   @map("invoice_file_name") @db.VarChar(255)
  invoiceNo         String?   @map("invoice_no") @db.VarChar(60)
  invoiceUploadedAt DateTime? @map("invoice_uploaded_at")

  notes          String?   @db.Text
  adminNote      String?   @map("admin_note") @db.Text
  // "havale" | "iyzico". Havalede sipariş PENDING açılır; yönetici parayı
  // hesapta görünce panelden onaylar (paidAt dolar, durum CONFIRMED olur).
  paymentMethod  String?   @map("payment_method") @db.VarChar(50)
  paidAt         DateTime? @map("paid_at")
  // "kargo" | "magaza" (Anamur içi mağazadan teslim; kargo ücreti alınmaz)
  deliveryMethod String    @default("kargo") @map("delivery_method") @db.VarChar(20)
  paymentToken   String?   @map("payment_token") @db.VarChar(512)
  paymentStatus  String?   @default("pending") @map("payment_status") @db.VarChar(20)
  paymentId      String?   @map("payment_id") @db.VarChar(100)
  formContent    String?   @map("form_content") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id])
  address        Address?        @relation(fields: [addressId], references: [id])
  brand          Brand           @relation(fields: [brandId], references: [id])
  items          OrderItem[]
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([brandId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentToken])
  @@map("orders")
}

// ─── FAVORİLER ────────────────────────────────────────────────────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

// ─── FORM KAYITLARI ───────────────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  brandKey  String?  @map("brand_key") @db.VarChar(30)
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(30)
  subject   String?  @db.VarChar(150)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([isRead])
  @@map("contact_messages")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String  @map("order_id")
  productId    String  @map("product_id")
  // Beden/yaş varyasyonu. Varyasyon sonradan silinse de sipariş kaydı
  // bozulmasın diye etiket ayrıca kopyalanıyor.
  variantId    String? @map("variant_id")
  variantLabel String? @map("variant_label") @db.VarChar(60)
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(10, 2)

  // Sipariş anındaki KDV oranı — ürünün oranı sonradan değişse de fatura bozulmaz
  vatRate   Int      @default(20) @map("vat_rate")
  vatAmount Decimal? @map("vat_amount") @db.Decimal(10, 2)

  // iyzico'nun bu sepet kalemi için ürettiği işlem kimliği.
  // `paymentId` ile AYNI DEĞİLDİR: paymentId tüm ödemeyi, bu ise tek kalemi
  // gösterir. Korumalı Alışveriş onayı (teslimat bildirimi) ve kalem bazlı
  // iade bu kimliği istiyor.
  paymentTransactionId String? @map("payment_transaction_id") @db.VarChar(60)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// ─── İade talebi (cayma hakkı) ────────────────────────────────────────────────
//
// Müşterinin ödeme adımında onayladığı CAYMA HAKKI metni "Hesabım >
// Siparişlerim > sipariş detayından iade talebinde bulunun" diyordu ama böyle
// bir mekanizma yoktu; teslim edilmiş üründe 14 günlük hakkı sitede kullanmanın
// yolu bulunmuyordu.
//
// Akış: müşteri talep açar (PENDING) → yönetici onaylar (APPROVED) ve müşteriye
// ürünü nasıl göndereceği bildirilir → ürün ulaşınca sipariş ekranındaki
// "Siparişi İade Et" ile para iade edilir ve talep COMPLETED olur.

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model ReturnRequest {
  id      String       @id @default(cuid())
  orderId String       @map("order_id")
  userId  String       @map("user_id") @db.Uuid
  status  ReturnStatus @default(PENDING)

  // Müşterinin gerekçesi. Cayma hakkında gerekçe zorunlu değil; yine de
  // operasyona yardımcı olsun diye alınıyor.
  reason String @db.Text

  // [{ orderItemId, quantity }] — hangi kalemler iade ediliyor
  items Json?

  adminNote  String?   @map("admin_note") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  resolvedAt DateTime? @map("resolved_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("return_requests")
}

// ─── Blog ─────────────────────────────────────────────────────────────────────
//
// Blog yazıları örnek veriden (`src/data/mock.ts`) geliyordu; içerikleri boştu
// ve yönetim ekranı olmadığı için güncellenemiyordu. Artık veritabanında.

model BlogPost {
  id         String  @id @default(cuid())
  brandId    Int     @map("brand_id")
  title      String  @db.VarChar(200)
  slug       String  @unique @db.VarChar(220)
  excerpt    String? @db.Text
  content    String  @db.Text
  category   String? @db.VarChar(80)
  coverImage String? @map("cover_image") @db.VarChar(500)
  author     String? @db.VarChar(120)

  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId, isPublished, publishedAt])
  @@index([slug])
  @@map("blog_posts")
}
