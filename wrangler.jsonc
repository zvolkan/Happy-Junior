{
	// ══════════════════════════════════════════════════════════════════════════
	// Cloudflare Workers yapılandırması
	//
	// <KÖŞELİ PARANTEZ> içindeki değerleri kendi kimliklerinizle doldurun.
	// Kimlikleri şu komutlar veriyor:
	//   npx wrangler hyperdrive create happy-junior-db --connection-string="..."
	//   npx wrangler kv namespace create HIZ_SINIRI
	// ══════════════════════════════════════════════════════════════════════════
	"name": "happy-junior",
	// OpenNext'in ürettiği worker DEĞİL, onu saran kendi girişimiz.
	// Sebebi: cron (scheduled) handler'ı eklemek. Bkz. custom-worker.ts
	"main": "./custom-worker.ts",
	// DİKKAT — bu tarih 2025-08-15'ten YENİ olmalı.
	// node:http / node:https istemci modülleri o tarihten itibaren nodejs_compat
	// ile birlikte otomatik açılıyor ve iyzico kütüphanesi buna bağlı.
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Kendi kendine istek atabilmek için (cron handler bunu kullanıyor)
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "happy-junior"
		}
	],
	// Supabase Postgres bağlantı havuzu.
	// Hyperdrive'a Supabase'in DIRECT CONNECTION adresini verin,
	// havuzlanmış (Supavisor / pooler) adresini DEĞİL.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// TODO(kurulum): `npx wrangler hyperdrive create happy-junior --connection-string=...`
			// komutunun verdiği kimlik buraya yazılacak.
			"id": "00000000000000000000000000000000",
			"localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
		}
	],
	// ISR / artımlı önbellek. Binding adı OpenNext tarafından bekleniyor.
	// Hız sınırı sayaçları — Durable Object.
	// Bellekteki Map Workers'ta işe yaramıyor; KV de tutarlılığı nihai olduğu
	// için kaba kuvvet anında sayım kaçırır. DO kesin sayım verir.
	// Bu bağlama KİMLİK GEREKTİRMEZ; sınıf custom-worker.ts'ten dışa veriliyor.
	"durable_objects": {
		"bindings": [
			{
				"name": "HIZ_SAYACI",
				"class_name": "HizSayaci"
			}
		]
	},
	// Durable Object sınıfının ilk kez tanıtılması
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"HizSayaci"
			]
		}
	],
	// Hangi sürümün çalıştığını bilmek için (src/lib/deployment.ts kullanıyor)
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	// Görsel optimizasyonu
	"images": {
		"binding": "IMAGES"
	},
	// Bekleyen sipariş temizliği — her gece 03:00 UTC (Türkiye saatiyle 06:00)
	"triggers": {
		"crons": [
			"0 3 * * *",
			"0 6 * * *",
			"30 * * * *"
		]
	},
	// Gizli OLMAYAN değerler burada durabilir.
	// Gizli olanlar (anahtarlar, parolalar) `wrangler secret put` ile konur.
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://happyjunioranamur.com"
	},
	"observability": {
		"enabled": true
	}
}